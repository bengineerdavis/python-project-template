[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ package_name }}"
version = "{{ project_version }}"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
{% if license.startswith('FSL') %}
# FSL identifiers are not SPDX-listed; the PEP 639 license key is omitted.
{% else %}
license = "{{ license }}"
{% endif %}
license-files = ["LICENSE*"]
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
keywords = ["cli"]
classifiers = [
  "Development Status :: 3 - Alpha",
  "Intended Audience :: Developers",
  "Operating System :: OS Independent",
  "Programming Language :: Python :: 3",
]

dependencies = [
  "typer>=0.12",
]

[project.scripts]
{{ cli_name }} = "{{ project_slug }}.cli:app"

{% if installer == 'pip-compile' %}
# pip-compile reads PEP 621 optional dependencies, not PEP 735 groups.
[project.optional-dependencies]
{% else %}
[dependency-groups]
{% endif %}
dev = [
  "pytest>=8",
  "ruff>=0.17",
{% if type_checker == 'pyrefly' %}
  "pyrefly>=1.0",
{% else %}
  "mypy>=1",
{% endif %}
]

{% if installer == 'poetry' %}
[tool.poetry]
requires-poetry = ">=2.3"
packages = [{ include = "{{ project_slug }}", from = "src" }]

[tool.poetry.requires-plugins]
poetry-plugin-export = ">=1.10"

{% endif %}
[tool.hatch.build.targets.wheel]
packages = ["src/{{ project_slug }}"]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = [
  "E",   # pycodestyle errors
  "W",   # pycodestyle warnings
  "F",   # pyflakes
  "I",   # isort
  "B",   # flake8-bugbear
  "C4",  # flake8-comprehensions
  "UP",  # pyupgrade
  "RUF", # ruff-specific
]

{% if type_checker == 'pyrefly' %}
[tool.pyrefly]
project-includes = ["src"]
python-version = "{{ python_version }}"
{% else %}
[tool.mypy]
python_version = "{{ python_version }}"
warn_unused_configs = true
ignore_missing_imports = true
{% endif %}

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
