# Base project harness — language concerns only. The agentic layer merges
# its tools and tasks into this file; keep this minimal and conventionally
# shaped so the layer's deep-merge (and aboyeur) can extend it safely.

#:schema https://mise.jdx.dev/schema/mise.json

[tools]
python = "{{ python_version }}"
prek = "latest"
{% if installer == 'uv' %}
uv = "latest"
{% elif installer == 'poetry' %}
poetry = "latest"
{% endif %}

[tasks.install]
description = "Bootstrap tools and register prek Git hooks (idempotent)"
run = '''
#!/usr/bin/env bash
set -euo pipefail
prek install --hook-type pre-commit --hook-type pre-push
'''

[tasks.lock]
description = "Resolve dependencies and write pylock.toml"
{% if installer == 'uv' %}
run = "uv lock && uv --quiet export --all-groups --format pylock.toml --output-file pylock.toml && python scripts/test_feedback.py record-lock --installer uv"
{% elif installer == 'poetry' %}
run = '''
#!/usr/bin/env bash
set -euo pipefail
unset VIRTUAL_ENV
export POETRY_KEYRING_ENABLED=false
poetry lock
if [[ ! -x .cache/poetry-export/bin/poetry ]]; then
  python -m venv .cache/poetry-export
  .cache/poetry-export/bin/python -m pip install "poetry>=2.3" "poetry-plugin-export>=1.10"
fi
poetry check --lock
.cache/poetry-export/bin/poetry export --all-groups --format pylock.toml --output pylock.toml
python scripts/test_feedback.py record-lock --installer poetry
'''
{% elif installer == 'pip' %}
run = '''
#!/usr/bin/env bash
set -euo pipefail
python -m venv .venv
.venv/bin/python -m pip install --upgrade "pip>=26.1"
.venv/bin/python -m pip lock -e . --group dev --output pylock.toml
python scripts/test_feedback.py record-lock --installer pip
'''
{% else %}
run = '''
#!/usr/bin/env bash
set -euo pipefail
python -m venv .venv
.venv/bin/python -m pip install --upgrade "pip>=26.1" "pip-tools>=7.6"
.venv/bin/python -m piptools compile --extra dev --strip-extras --generate-hashes --output-file requirements.txt pyproject.toml
.venv/bin/python -m pip lock --requirement requirements.txt --output pylock.toml
python scripts/test_feedback.py record-lock --installer pip-compile
'''
{% endif %}

[tasks.sync]
description = "Install existing lock artifacts without resolving dependencies"
{% if installer == 'uv' %}
run = "python scripts/test_feedback.py sync --installer uv"
{% elif installer == 'poetry' %}
run = 'python scripts/test_feedback.py sync --installer poetry'
{% elif installer == 'pip' %}
run = 'python scripts/test_feedback.py sync --installer pip'
{% else %}
run = 'python scripts/test_feedback.py sync --installer pip-compile'
{% endif %}

[tasks.test]
description = "Fast feedback after a logical edit"
run = 'prek exec test-fast -- python scripts/test_feedback.py fast --installer {{ installer }} "$@"'

[tasks."test:all"]
description = "Run full-suite verification"
run = 'python scripts/test_feedback.py full --installer {{ installer }} "$@"'

[tasks."test:flaky"]
description = "Investigate nondeterminism in two independent test runs"
run = 'python scripts/test_feedback.py flaky --installer {{ installer }} "$@"'

[tasks.lint]
description = "Ruff lint"
depends = ["sync"]
run = "{{ run_prefix }} ruff check src tests"

[tasks.format]
description = "Auto-fix lint findings and format"
depends = ["sync"]
run = '''
#!/usr/bin/env bash
set -euo pipefail
{{ run_prefix }} ruff check --fix src tests
{{ run_prefix }} ruff format src tests
'''

[tasks.format-check]
description = "Verify formatting and lint cleanliness"
depends = ["sync"]
run = '''
#!/usr/bin/env bash
set -euo pipefail
{{ run_prefix }} ruff format --check src tests
{{ run_prefix }} ruff check src tests
'''

[tasks.type-check]
description = "Type-check src with {{ type_checker }}"
depends = ["sync"]
{% if type_checker == 'pyrefly' %}
run = "{{ run_prefix }} pyrefly check"
{% else %}
run = "{{ run_prefix }} mypy src"
{% endif %}

[tasks.quality]
description = "All code-quality gates (lint, format, types)"
depends = ["lint", "format-check", "type-check"]

[tasks.clean]
description = "Remove local build and test artifacts, including the virtual environment"
run = '''
#!/usr/bin/env bash
set -euo pipefail
# The state file records which lock the environment was synced from. Removing
# the environment without it would leave `mise run test` believing the
# environment still matches and skipping the sync.
rm -rf .venv .cache/test-feedback
find . -path ./.git -prune -o -type d -name __pycache__ -exec rm -rf {} +
rm -rf .pytest_cache .ruff_cache .mypy_cache .pyrefly_cache .coverage htmlcov
rm -rf tmp/pytest
echo "removed local Python artifacts; run mise run install to rebuild"
'''

[tasks.cache-prune]
description = "Shed the local uv cache entries this environment no longer references"
run = '''
#!/usr/bin/env bash
set -euo pipefail
cache_dir=$(uv cache dir)
before=$(du -sm "$cache_dir" | cut -f1)
# --ci is uv's own convention for a disposable run: it drops unneeded
# pre-built wheels and keeps wheels built from source. A plain prune does not
# reclaim entries left behind by deleted environments, so it barely shrinks a
# cache filled by throwaway project renders.
uv cache prune --ci --force
after=$(du -sm "$cache_dir" | cut -f1)
printf 'uv cache: %s MB -> %s MB (reclaimed %s MB)\n' \
  "$before" "$after" "$((before - after))"
'''
