#:schema https://www.schemastore.org/prek.json

default_install_hook_types = ["pre-commit", "pre-push"]

# Code semantics only. Division of labor with the agentic layer (stamped on
# top of this base): ruff owns code and config-file semantics here; the
# layer adds alint (repository shape and content hygiene) and tombi (TOML).
# No generic builtin hooks in this file — in layer-stamped projects alint
# owns trailing whitespace, final newlines, and merge markers, and running
# two tools on the same bytes teaches agents to ignore one of them.

[[repos]]
repo = "local"
hooks = [
  {
    id = "test-fast",
    name = "Fast test feedback",
    language = "system",
    entry = "python scripts/test_feedback.py fast --installer {{ installer }}",
    stages = ["manual", "pre-commit"],
    always_run = true,
    pass_filenames = false,
    verbose = true,
    require_serial = true,
  },
  {
    id = "test-all",
    name = "Full test verification",
    language = "system",
    entry = "python scripts/test_feedback.py full --installer {{ installer }}",
    stages = ["manual", "pre-push"],
    always_run = true,
    pass_filenames = false,
    verbose = true,
  },
  {
    id = "test-flaky",
    name = "Flaky test investigation",
    language = "system",
    entry = "python scripts/test_feedback.py flaky --installer {{ installer }}",
    stages = ["manual"],
    always_run = true,
    pass_filenames = false,
    verbose = true,
  },
]

[[repos]]
repo = "https://github.com/astral-sh/ruff-pre-commit"
rev = "v0.17.1"
hooks = [
  { id = "ruff", args = ["--fix"] },
  { id = "ruff-format" },
]
