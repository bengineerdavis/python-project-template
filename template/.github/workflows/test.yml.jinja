name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

{% if installer == 'uv' %}
      - uses: astral-sh/setup-uv@v5
        with:
          python-version: "{{ python_version }}"
{% else %}
      - uses: actions/setup-python@v5
        with:
          python-version: "{{ python_version }}"
{% endif %}

{% if installer == 'poetry' %}
      - name: Install Poetry
        run: python -m pip install "poetry>=2.3" "poetry-plugin-export>=1.10"
{% endif %}

      - name: Verify locks and sync dependencies
        run: python scripts/test_feedback.py ci --installer {{ installer }}

      - name: Lint
        run: {{ run_prefix }} ruff check src tests

      - name: Format check
        run: {{ run_prefix }} ruff format --check src tests

      - name: Type check
{% if type_checker == 'pyrefly' %}
        run: {{ run_prefix }} pyrefly check
{% else %}
        run: {{ run_prefix }} mypy src
{% endif %}

      - name: Test
        run: python scripts/test_feedback.py full --installer {{ installer }} --json
